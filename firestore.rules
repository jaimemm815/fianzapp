// Given by the skeleton: these rules let nobody read or write anything, so that
// nothing is open by mistake while you set up Firebase.
//
// A6: replace this whole file, this comment included, with rules that let in only the right
// people. "if request.auth != null" on its own is not enough (Session 9 Guide, section 12).
// Paste this file in the Firebase console, in Firestore's Rules tab, and publish it. Keep
// this file and the console equal: the rules you are marked on are the ones in this file.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
